---
// Cabecera común. El logo es el de Platform (la llave), no el de Distamus:
// este sitio es un servicio concreto, no el portal del ecosistema.
//
// Cápsula flotante en lugar de barra pegada al borde: en la home se
// superpone al hero a pantalla completa, así que no puede tener fondo
// sólido ni ocupar una franja propia. En el resto de páginas el mismo
// componente se apoya sobre el fondo normal y sigue leyéndose.
const { pathname } = Astro.url;
const enSobre = pathname.startsWith('/sobre-nosotros');
const enHome = pathname === '/' || pathname === '';
---

<header class:list={['topbar', { 'topbar--over': enHome }]}>
  <div class="capsule">
    <a class="brand" href="/" aria-label="Distamus Platform">
      <span class="brand-mark">
        <img src="/favicon.svg" alt="" width="26" height="26" />
      </span>
      <span class="brand-text">Distamus Platform</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <a href="/" class="nav-link" aria-current={enHome ? 'page' : undefined}>Inicio</a>
      <a href="/#origen" class="nav-link">Versiones</a>
      <a href="/#integracion" class="nav-link">Productos</a>
      <a href="/#arbol" class="nav-link">Registro</a>
      <a href="/sobre-nosotros" class="nav-link" aria-current={enSobre ? 'page' : undefined}>Acerca de</a>
    </nav>

    <div class="actions">
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Cambiar entre tema claro y oscuro">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <a class="cta" href="/#origen">
        <span>Ver el archivo</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 14px;
    z-index: 30;
    padding: 14px 16px 0;
  }

  /* Sobre el hero la cápsula flota encima de la imagen: no reserva
     altura, así que el hero llega hasta el borde superior en vez de
     quedar bajo una franja de fondo.

     `width:100%` además de left/right: sin él, un contenedor sin ancho
     explícito deja que el elemento absoluto se encoja a su contenido, y
     la página entera se quedaba a media anchura en móvil. */
  .topbar--over {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
  }

  .capsule {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    width: 100%;
    max-width: 940px;
    margin: 0 auto;
    padding: 8px 8px 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(28, 20, 58, 0.42);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow: 0 10px 40px -12px rgba(15, 8, 40, 0.5);
  }

  /* Fuera del hero el fondo es claro u oscuro según el tema, así que la
     cápsula toma los tokens normales en lugar del cristal violeta. */
  .topbar:not(.topbar--over) .capsule {
    border-color: var(--pg-border);
    background: color-mix(in srgb, var(--pg-surface) 88%, transparent);
    box-shadow: var(--pg-shadow);
  }

  /* ---------- Marca ---------- */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--grad-platform);
  }
  .brand-mark img { width: 18px; height: 18px; }

  .brand-text {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .topbar:not(.topbar--over) .brand-text { color: var(--pg-text); }

  /* ---------- Navegación ---------- */
  .nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0 auto;
  }

  .nav-link {
    position: relative;
    padding: 7px 12px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s ease;
  }
  .nav-link:hover { color: #fff; }

  /* La página actual se marca con un subrayado corto, como en la
     referencia: más discreto que una píldora rellena. */
  .nav-link[aria-current='page'] { color: #fff; font-weight: 600; }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 1px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }

  .topbar:not(.topbar--over) .nav-link { color: var(--pg-muted); }
  .topbar:not(.topbar--over) .nav-link:hover,
  .topbar:not(.topbar--over) .nav-link[aria-current='page'] { color: var(--pg-text); }

  /* ---------- Acciones ---------- */
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .theme-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease;
  }
  .theme-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.1); }
  .topbar:not(.topbar--over) .theme-btn { color: var(--pg-muted); }
  .topbar:not(.topbar--over) .theme-btn:hover { color: var(--pg-text); background: var(--pg-bg); }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 17px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .cta:hover { background: rgba(255, 255, 255, 0.24); transform: translateY(-1px); }
  .cta svg { transition: transform 0.18s ease; }
  .cta:hover svg { transform: translateX(2px); }

  .topbar:not(.topbar--over) .cta {
    border-color: transparent;
    background: var(--grad-platform);
  }

  .theme-btn:focus-visible,
  .nav-link:focus-visible,
  .cta:focus-visible,
  .brand:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .topbar:not(.topbar--over) :is(.theme-btn, .nav-link, .cta, .brand):focus-visible {
    outline-color: var(--pf-purple);
  }

  .icon-moon { display: none; }
  :global([data-theme='dark']) .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-moon { display: block; }

  /* ---------- Responsive ----------
     La navegación completa no cabe en móvil. En vez de un menú
     desplegable, que aquí sería un botón más que mantener, se ocultan
     los enlaces secundarios: la marca lleva al inicio y el botón de
     acción lleva al archivo, que es a donde va casi todo el mundo. */
  @media (max-width: 860px) {
    .nav { display: none; }
    .capsule {
      max-width: 520px;
      justify-content: space-between;
      /* El gap fijo de escritorio no deja encoger a los extremos y la
         cápsula se salía por la derecha en pantallas estrechas. */
      gap: 8px;
      padding: 7px 7px 7px 13px;
    }
    /* Los tres hijos pueden encogerse por debajo de su contenido; sin
       esto, flex respeta su tamaño mínimo y el conjunto desborda. */
    .brand,
    .actions { min-width: 0; }
    .brand-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (max-width: 420px) {
    .cta span { display: none; }
    .cta { padding: 9px 12px; }
    .brand-text { font-size: 0.88rem; }
  }

  /* Por debajo de 340px ni el nombre completo ni el botón caben a la
     vez: se deja solo la marca corta y el botón, que es la acción. */
  @media (max-width: 340px) {
    .brand-text { display: none; }
  }
</style>
