---
// Cabecera común. El logo es el de Platform (la llave), no el de Distamus:
// este sitio es un servicio concreto, no el portal del ecosistema.
const { pathname } = Astro.url;
const enSobre = pathname.startsWith('/sobre-nosotros');
---

<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="/" aria-label="Distamus Platform">
      <span class="brand-mark">
        <img src="/favicon.svg" alt="" width="44" height="44" />
      </span>
      <span class="brand-text">
        <strong>Distamus</strong>
        <em>Platform</em>
      </span>
    </a>

    <nav class="nav">
      <a href="/#origen" class="nav-link">Línea evolutiva</a>
      <a href="/sobre-nosotros" class="nav-link" aria-current={enSobre ? 'page' : undefined}>
        Sobre nosotros
      </a>
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Cambiar entre tema claro y oscuro">
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--pg-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--pg-border);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* El logo de Platform viene con fondo blanco y en una sola versión, así que
     va sobre una placa clara fija en vez de cambiar con el tema. */
  .brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: #fff;
    border: 1px solid var(--pg-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* El trazo del logo deja mucho aire alrededor, así que se escala por encima
     de la placa y se recorta: si no, se ve diminuto dentro del recuadro. */
  .brand-mark img {
    width: 62px;
    height: 62px;
    object-fit: contain;
  }

  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text strong { font-size: 0.92rem; font-weight: 800; letter-spacing: -0.01em; }

  .brand-text em {
    font-style: normal;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pf-purple);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    padding: 7px 13px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pg-muted);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }

  .nav-link:hover { color: var(--pg-text); background: var(--pg-surface); }

  .nav-link[aria-current='page'] {
    color: var(--pf-purple);
    background: rgba(139, 92, 246, 0.1);
  }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-left: 0.35rem;
    border-radius: 10px;
    background: var(--pg-surface);
    border: 1px solid var(--pg-border);
    color: var(--pg-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .theme-btn:hover { color: var(--pf-purple); border-color: var(--pf-purple); }
  .theme-btn:focus-visible { outline: 2px solid var(--pf-purple); outline-offset: 3px; }
  .nav-link:focus-visible { outline: 2px solid var(--pf-purple); outline-offset: 2px; }

  .icon-moon { display: none; }
  :global([data-theme='dark']) .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-moon { display: block; }

  @media (max-width: 520px) {
    .nav-link { padding: 6px 9px; font-size: 0.78rem; }
    .brand-text em { display: none; }
  }
</style>
