---
import Layout from '../../layouts/Layout.astro';
import Topbar from "../../components/Topbar.astro";
import { productos } from '../../data/evolucion';

export function getStaticPaths() {
  return productos.map(producto => ({
    params: { slug: producto.slug },
    props: { producto },
  }));
}

const { producto } = Astro.props;

// El orden de lectura es al revés que en la línea evolutiva: aquí interesa
// primero lo último que ha pasado.
const versiones = [...producto.versiones].reverse();
const documentadas = producto.versiones.filter(v => !v.sinRegistro).length;
---

<Layout
  title={`${producto.nombre} — Historial de versiones · Distamus Platform`}
  description={`${producto.resumen} Versión actual: ${producto.versionActual}.`}
  keywords={`${producto.nombre}, versiones, historial, changelog, Distamus Platform`}
>
  <Topbar />

  <main>
    <section class="ficha">
      <div class="container">
        <a class="back" href="/#origen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Línea evolutiva
        </a>

        <span class="orden">{producto.orden}</span>
        <h1 class="ficha-title">{producto.nombre}</h1>
        <p class="ficha-lema">{producto.lema}</p>

        <div class="actual glass">
          <div class="actual-main">
            <span class="actual-label">Versión actual</span>
            <strong class="actual-version">{producto.versionActual}</strong>
          </div>
          <div class="actual-side">
            <span class={`estado estado--${producto.estado}`}>{producto.estadoTexto}</span>
            <p>{producto.versionActualNota}</p>
          </div>
        </div>

        <p class="ficha-resumen">{producto.resumen}</p>

        <div class="meta">
          <div><strong>{producto.versiones.length}</strong><span>versiones en total</span></div>
          <div><strong>{documentadas}</strong><span>con registro público</span></div>
          <div><strong>{producto.etapa === 'origen' ? 'Origen' : 'Integración'}</strong><span>etapa</span></div>
        </div>
      </div>
    </section>

    <section class="historial">
      <div class="container">
        <h2 class="historial-title">Qué había en cada versión</h2>
        <p class="historial-sub">
          De la más reciente a la más antigua. Todo lo documentado aquí procede de Distamus Blogs.
        </p>

        <ol class="timeline">
          {versiones.map(version => (
            <li class={`tl-item${version.estado ? ` is-${version.estado}` : ''}`}>
              <div class="tl-marker" aria-hidden="true"></div>
              <div class="tl-body glass">
                <header class="tl-head">
                  <h3>{version.etiqueta}</h3>
                  {version.fecha && <span class="tl-date">{version.fecha}</span>}
                  {version.estado === 'actual' && <span class="tl-badge tl-badge--actual">Actual</span>}
                  {version.estado === 'desarrollo' && <span class="tl-badge tl-badge--wip">En desarrollo</span>}
                  {version.estado === 'proxima' && <span class="tl-badge tl-badge--next">Próxima</span>}
                </header>

                {version.titular && <p class="tl-titular">{version.titular}</p>}

                {version.cambios && version.cambios.length > 0 && (
                  <ul class="tl-cambios">
                    {version.cambios.map(cambio => <li>{cambio}</li>)}
                  </ul>
                )}

                {version.sinRegistro && (
                  <p class="tl-vacio">
                    Sin entrada propia en Distamus Blogs. Esta versión existió, pero no hay un
                    registro público de lo que incluyó.
                  </p>
                )}

                {version.fuente && (
                  <p class="tl-fuente">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h11a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2z" /><path d="M9 8h5" />
                    </svg>
                    Fuente:{' '}
                    {version.fuente.url ? (
                      <a href={version.fuente.url} target="_blank" rel="noopener noreferrer">{version.fuente.texto}</a>
                    ) : (
                      version.fuente.texto
                    )}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>

        {producto.curiosidad && (
          <aside class="curiosidad glass">
            <span class="curiosidad-tag">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" />
              </svg>
              Dato curioso
            </span>
            <h3>{producto.curiosidad.titulo}</h3>
            <p>{producto.curiosidad.texto}</p>
          </aside>
        )}

        <aside class="cierre glass">
          <span class="cierre-tag">Contexto</span>
          <p>{producto.nota}</p>
        </aside>
      </div>
    </section>

    <nav class="otros">
      <div class="container">
        <h2>Otros productos</h2>
        <div class="otros-grid">
          {productos
            .filter(otro => otro.slug !== producto.slug)
            .map(otro => (
              <a class="otro" href={`/producto/${otro.slug}`}>
                <span class="otro-orden">{otro.orden}</span>
                <strong>{otro.nombre}</strong>
                <span class="otro-version">{otro.versionActual}</span>
              </a>
            ))}
        </div>
      </div>
    </nav>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>Distamus Platform · Archivo histórico del ecosistema</span>
      <span>Fuente: Distamus Blogs</span>
    </div>
  </footer>
</Layout>

<style>
  /* ── Ficha ── */
  .ficha { padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(1.5rem, 3vw, 2rem); }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--pg-muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }

  .back:hover { color: var(--pf-purple); }

  .orden {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.22);
    color: var(--pf-purple);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }

  .ficha-title {
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    padding-bottom: 0.08em;
    text-wrap: balance;
  }

  .ficha-lema {
    font-size: 1.05rem;
    color: var(--pg-muted);
    margin-bottom: 2rem;
  }

  .actual {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    padding: 1.5rem 1.75rem;
    border-radius: 20px;
    border-left: 3px solid var(--pf-purple);
    margin-bottom: 1.75rem;
  }

  .actual-main { display: flex; flex-direction: column; gap: 0.1rem; }

  .actual-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pg-light);
  }

  .actual-version {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: var(--grad-platform);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .actual-side { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 0.6rem; }
  .actual-side p { font-size: 0.92rem; line-height: 1.65; color: var(--pg-muted); }

  .estado {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--pg-surface);
    border: 1px solid var(--pg-border);
    color: var(--pg-muted);
  }

  .estado--activo     { background: rgba(16,185,129,0.1); color: var(--pf-green);  border-color: rgba(16,185,129,0.25); }
  .estado--desarrollo { background: rgba(245,158,11,0.1); color: var(--pf-amber);  border-color: rgba(245,158,11,0.25); }
  .estado--proxima    { background: rgba(59,130,246,0.1); color: var(--pf-blue);   border-color: rgba(59,130,246,0.25); }
  .estado--integrado  { background: rgba(139,92,246,0.1); color: var(--pf-purple); border-color: rgba(139,92,246,0.25); }
  .estado--completado { background: rgba(20,184,166,0.1); color: var(--pf-teal);   border-color: rgba(20,184,166,0.25); }

  .ficha-resumen {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--pg-muted);
    max-width: 760px;
    margin-bottom: 1.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--pg-border);
    border-bottom: 1px solid var(--pg-border);
  }

  .meta div { display: flex; flex-direction: column; }
  .meta strong { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; }
  .meta span { font-size: 0.75rem; color: var(--pg-light); font-weight: 600; }

  /* ── Historial ── */
  .historial { padding: clamp(2.5rem, 6vw, 4rem) 0; }

  .historial-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }

  .historial-sub {
    font-size: 0.95rem;
    color: var(--pg-muted);
    margin-bottom: 2.25rem;
  }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    position: relative;
    padding-left: 1.65rem;
  }

  /* Hilo vertical que une todas las versiones */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: var(--pg-border);
  }

  .tl-item { position: relative; }

  .tl-marker {
    position: absolute;
    left: -1.65rem;
    top: 1.4rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--pg-bg);
    border: 2px solid var(--pg-light);
  }

  .tl-item.is-actual .tl-marker { border-color: var(--pf-purple); background: var(--pf-purple); }
  .tl-item.is-desarrollo .tl-marker { border-color: var(--pf-amber); border-style: dashed; }
  .tl-item.is-proxima .tl-marker { border-color: var(--pf-blue); border-style: dashed; }

  .tl-body { padding: 1.35rem 1.5rem; border-radius: 16px; }
  .tl-item.is-actual .tl-body { border-color: rgba(139, 92, 246, 0.35); }

  .tl-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .tl-head h3 { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em; }

  .tl-date { font-size: 0.8rem; color: var(--pg-light); font-weight: 600; }

  .tl-badge {
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .tl-badge--actual { background: rgba(139,92,246,0.14); color: var(--pf-purple); }
  .tl-badge--wip    { background: rgba(245,158,11,0.14); color: var(--pf-amber); }
  .tl-badge--next   { background: rgba(59,130,246,0.14); color: var(--pf-blue); }

  .tl-titular {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--pg-text);
    margin-bottom: 0.85rem;
  }

  .tl-cambios {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .tl-cambios li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--pg-muted);
  }

  .tl-cambios li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--pf-purple);
    opacity: 0.7;
  }

  .tl-vacio {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--pg-light);
    font-style: italic;
  }

  .tl-fuente {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--pg-border);
    font-size: 0.78rem;
    color: var(--pg-light);
  }

  .tl-fuente a {
    color: var(--pf-purple);
    font-weight: 600;
    text-decoration: none;
  }

  .tl-fuente a:hover { text-decoration: underline; }

  .curiosidad {
    margin-top: 1.75rem;
    padding: 1.5rem 1.7rem;
    border-radius: 16px;
    border-left: 3px solid var(--pf-amber);
    background:
      linear-gradient(160deg, rgba(245, 158, 11, 0.07), transparent 60%),
      var(--pg-glass);
  }

  .curiosidad-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pf-amber);
    margin-bottom: 0.6rem;
  }

  .curiosidad h3 {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }

  .curiosidad p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--pg-muted);
  }

  .cierre {
    margin-top: 1.25rem;
    padding: 1.4rem 1.6rem;
    border-radius: 16px;
    border-left: 3px solid var(--pf-blue);
  }

  .cierre-tag {
    display: inline-block;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pf-blue);
    margin-bottom: 0.5rem;
  }

  .cierre p { font-size: 0.95rem; line-height: 1.75; color: var(--pg-muted); }

  /* ── Otros productos ── */
  .otros { padding: clamp(2rem, 5vw, 3.5rem) 0; border-top: 1px solid var(--pg-border); }

  .otros h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .otros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.75rem;
  }

  .otro {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.15rem;
    border-radius: 14px;
    background: var(--pg-surface);
    border: 1px solid var(--pg-border);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .otro:hover { border-color: var(--pf-purple); transform: translateY(-3px); }

  .otro-orden { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em; color: var(--pf-purple); }
  .otro strong { font-size: 0.95rem; font-weight: 700; }
  .otro-version { font-size: 0.78rem; color: var(--pg-light); }

  /* ── Pie ── */
  .footer { border-top: 1px solid var(--pg-border); padding: 1.75rem 0; }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--pg-light);
  }

  @media (max-width: 640px) {
    .meta { gap: 1.5rem; }
    .footer-inner { justify-content: center; text-align: center; }
  }
</style>
