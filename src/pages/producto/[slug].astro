---
import Layout from '../../layouts/Layout.astro';
import ProductPage from '../../components/platform/ProductPage';
import { productos } from '../../data/evolucion';
import '../../styles/index.css';
import '../../styles/interior.css';

export function getStaticPaths() {
  return productos.map(producto => ({ params: { slug: producto.slug }, props: { producto } }));
}
const { producto } = Astro.props;
const related = productos.filter(item => item.slug !== producto.slug).map(({ slug, nombre, orden, versionActual }) => ({ slug, nombre, orden, versionActual }));
---
<Layout title={`${producto.nombre} — Historial de versiones · Distamus Platform`} description={`${producto.resumen} Versión actual: ${producto.versionActual}.`}>
  <ProductPage product={producto} related={related} client:load />
</Layout>
