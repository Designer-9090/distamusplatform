---
import Layout from '../layouts/Layout.astro';
import Topbar from "../components/Topbar.astro";
import ProductoEvolucion from '../components/ProductoEvolucion.astro';
import { porEtapa, lineasAbiertas, productos } from '../data/evolucion';

const origen = porEtapa('origen');
const integracion = porEtapa('integracion');
const totalVersiones = productos.reduce((suma, p) => suma + p.versiones.length, 0);
const documentadas = productos.reduce(
  (suma, p) => suma + p.versiones.filter(v => !v.sinRegistro).length,
  0
);
---

<Layout title="Distamus Platform — El archivo histórico oficial">
  <Topbar />

  <main>
    <!-- ═══════════════ HERO ═══════════════ -->
    <section class="hero">
      <div class="hero-glow hero-glow--purple" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--blue" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-grid">
          <div class="hero-main">
            <span class="eyebrow">Archivo histórico oficial</span>
            <h1 class="hero-title">La evolución de <span class="text-grad">Distamus</span></h1>
            <p class="hero-lead">
              Distamus no nació como una plataforma con muchos servicios. Nació como una colección
              de productos independientes que, con el tiempo, fueron integrándose hasta formar un
              ecosistema. Esta es esa historia, versión a versión.
            </p>
            <div class="hero-acciones">
              <a class="hero-cta" href="#origen">
                Empezar por el origen
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 5v14M5 12l7 7 7-7" />
                </svg>
              </a>
              <a class="hero-cta-sec" href="#arbol">Ver el árbol completo</a>
            </div>
          </div>

          <!-- Índice del ecosistema: sirve de resumen y de acceso directo a
               cada ficha, en vez de dejar el hero medio vacío. -->
          <aside class="hero-panel glass" aria-labelledby="hero-panel-title">
            <div class="panel-head">
              <h2 id="hero-panel-title">Estado del ecosistema</h2>
              <span>Versión vigente de cada producto</span>
            </div>
            <ul class="panel-lista">
              {productos.map(producto => (
                <li>
                  <a href={`/producto/${producto.slug}`}>
                    <span class={`panel-punto panel-punto--${producto.estado}`} aria-hidden="true"></span>
                    <span class="panel-nombre">{producto.nombre}</span>
                    <span class="panel-version">{producto.versionActual}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <strong>{productos.length}</strong>
            <span>productos registrados</span>
          </div>
          <div class="stat">
            <strong>{totalVersiones}</strong>
            <span>versiones en total</span>
          </div>
          <div class="stat">
            <strong>{documentadas}</strong>
            <span>con registro público</span>
          </div>
          <div class="stat">
            <strong>{lineasAbiertas.length}</strong>
            <span>líneas abiertas</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ PRIMERA GENERACIÓN ═══════════════ -->
    <section class="section" id="origen">
      <div class="container">
        <!-- La raíz del árbol abre la sección: es de donde cuelga todo lo demás. -->
        <div class="root glass reveal">
          <img class="root-logo root-logo--light" src="/user-avatar.webp" alt="" width="72" height="72" loading="lazy" />
          <img class="root-logo root-logo--dark" src="/user-avatar-modeblack.webp" alt="" width="72" height="72" loading="lazy" />
          <div class="root-text">
            <strong>Distamus</strong>
            <span>De productos sueltos a ecosistema</span>
          </div>
        </div>

        <div class="head reveal">
          <span class="tag">Primera generación</span>
          <h2>Los productos originales</h2>
          <p>
            Cuatro productos concretos, cada uno con su propio ciclo de versiones. Primero Time;
            después Edu, Book y Game.
          </p>
        </div>

        <div class="list reveal">
          {origen.map(producto => <ProductoEvolucion producto={producto} />)}
        </div>

        <div class="portal glass reveal">
          <span class="portal-tag">Distamus Home</span>
          <h3>Home no es un servicio: es el portal</h3>
          <p>
            Su función es actuar como puerta de entrada al ecosistema, mientras que los productos
            son los que aportan las funcionalidades. Por eso no aparece en esta lista junto a Time,
            Edu, Book o Game.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════ SEGUNDA ETAPA ═══════════════ -->
    <section class="section" id="integracion">
      <div class="container">
        <div class="head reveal">
          <span class="tag">Segunda etapa</span>
          <h2>La integración</h2>
          <p>
            En lugar de mantener cada producto completamente separado, Distamus empieza a integrar
            funcionalidades. <strong>Time dentro de Multitasking</strong> es el mejor ejemplo de esa
            transformación: una aplicación con su propio ciclo de versiones acaba convertida en una
            función de otro producto.
          </p>
        </div>

        <div class="list reveal">
          {integracion.map(producto => <ProductoEvolucion producto={producto} />)}
        </div>
      </div>
    </section>

    <!-- ═══════════════ LÍNEAS ABIERTAS ═══════════════ -->
    <section class="section" id="abierto">
      <div class="container">
        <div class="head reveal">
          <span class="tag">Ahora mismo</span>
          <h2>Las líneas abiertas</h2>
          <p>El árbol de evolución tiene hoy tres ramas creciendo, y una que ya no crece por versiones.</p>
        </div>

        <div class="lines reveal">
          {lineasAbiertas.map(linea => (
            <div class="line">
              <span class="line-tag">En desarrollo</span>
              <strong>{linea.producto} → {linea.destino}</strong>
              <span class="line-detail">{linea.detalle}</span>
            </div>
          ))}
          <div class="line line--done">
            <span class="line-tag line-tag--done">Completado</span>
            <strong>Distapria</strong>
            <span class="line-detail">Sin sistema de versiones</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ ÁRBOL ═══════════════ -->
    <section class="section" id="arbol">
      <div class="container">
        <div class="head reveal">
          <span class="tag">Vista completa</span>
          <h2>El árbol del ecosistema</h2>
          <p>Toda la historia ordenada según el nacimiento de cada producto.</p>
        </div>

        <div class="tree glass reveal">
          <pre><code>DISTAMUS
│
├── Distamus Time
│   └── v1 → v1.25 → v1.5 → v1.75 → v2
│       → v2.1 → v2.2 → v2.3 → v3 → v3.5 → v4
│       └── Integrado después en Multitasking
│
├── Distamus Edu
│   └── v1 → v2 → v3 ⇢ v6
│
├── Distamus Book
│   └── v1 → v2 → v3   (20 sep 2026)
│
├── Distamus Game
│   └── v1 → v2 → v3
│
├── Distamus Home
│   └── PORTAL
│       └── No es un servicio
│
├── Distamus Multitasking
│   └── v1 → v1.5 → v2 → v2.1 → v2.2 → v2.3
│       └── v2.4  · en desarrollo
│
├── Distamus Octopus
│   └── Beta v0.5
│       └── Beta v0.75  · en desarrollo
│           └── Editor de vídeo
│
└── Distapria
    └── Sin versiones
        └── Salió completo el 22 ago 2026</code></pre>
        </div>
      </div>
    </section>

    <!-- ═══════════════ CIERRE ═══════════════ -->
    <section class="closing">
      <div class="closing-glow" aria-hidden="true"></div>
      <div class="container closing-inner reveal">
        <p class="closing-kicker">Y la historia se lee así</p>
        <blockquote class="closing-quote">
          Integración de productos<br />
          <span class="text-grad">→ servicios → plataforma → ecosistema.</span>
        </blockquote>
        <p class="closing-note">
          Primero llegó Time. Después Edu, Book y Game. Luego Home, como portal para reunirlo todo.
          Y a partir de ahí, Distamus dejó de ser un conjunto de productos sueltos.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>Distamus Platform · Archivo histórico del ecosistema</span>
      <span class="footer-date">Actualizado el 1 de septiembre de 2026</span>
    </div>
  </footer>
</Layout>

<style>
  /* ─────────── Hero ─────────── */
  .hero {
    position: relative;
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(3.5rem, 8vw, 5rem);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.18;
    pointer-events: none;
  }

  .hero-glow--purple {
    width: 560px;
    height: 460px;
    background: var(--pf-purple);
    top: -180px;
    left: 50%;
    transform: translateX(-60%);
  }

  .hero-glow--blue {
    width: 420px;
    height: 380px;
    background: var(--pf-blue);
    top: -100px;
    right: -110px;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    }
  }

  .hero-main { max-width: 620px; }

  .eyebrow {
    display: inline-block;
    padding: 5px 15px;
    border-radius: 100px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.22);
    color: var(--pf-purple);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.35rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    padding: 0.1em 0 0.16em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--pg-muted);
    line-height: 1.8;
    margin-bottom: 2.25rem;
  }

  /* Las cifras cierran el hero a todo lo ancho, debajo de las dos columnas. */
  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--pg-border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .stat strong {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: var(--grad-platform);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat span {
    font-size: 0.78rem;
    color: var(--pg-light);
    font-weight: 600;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.85rem 1.9rem;
    border-radius: 100px;
    background: var(--grad-platform);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.3);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease;
  }

  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px rgba(139, 92, 246, 0.45);
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .hero-cta-sec {
    padding: 0.85rem 1.5rem;
    border-radius: 100px;
    border: 1px solid var(--pg-border);
    color: var(--pg-muted);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .hero-cta-sec:hover {
    color: var(--pg-text);
    border-color: var(--pf-purple);
  }

  .hero-cta:focus-visible,
  .hero-cta-sec:focus-visible {
    outline: 2px solid var(--pf-purple);
    outline-offset: 3px;
  }

  /* ─────────── Panel del hero ─────────── */
  .hero-panel {
    padding: 1.5rem 1.6rem;
    border-radius: 20px;
  }

  .panel-head {
    padding-bottom: 0.9rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--pg-border);
  }

  .panel-head h2 {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.1rem;
  }

  .panel-head span {
    font-size: 0.78rem;
    color: var(--pg-light);
  }

  .panel-lista {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .panel-lista a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .panel-lista a:hover { background: var(--pg-surface); }

  .panel-lista a:focus-visible {
    outline: 2px solid var(--pf-purple);
    outline-offset: -2px;
  }

  .panel-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--pg-light);
  }

  .panel-punto--activo     { background: var(--pf-green); }
  .panel-punto--desarrollo { background: var(--pf-amber); }
  .panel-punto--proxima    { background: var(--pf-blue); }
  .panel-punto--integrado  { background: var(--pf-purple); }
  .panel-punto--completado { background: var(--pf-teal); }

  .panel-nombre {
    flex: 1;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--pg-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .panel-version {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--pg-muted);
    white-space: nowrap;
  }

  /* ─────────── Secciones ─────────── */
  .section {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  /* La cabecera es fija: sin esto, al saltar a un ancla el título queda debajo. */
  .section[id] {
    scroll-margin-top: 84px;
  }

  .section + .section {
    border-top: 1px solid var(--pg-border);
  }

  .head {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .tag {
    display: inline-block;
    padding: 4px 13px;
    border-radius: 100px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--pf-blue);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  .head h2 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .head p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--pg-muted);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ─────────── Raíz ─────────── */
  .root {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    padding: 1.6rem 1.85rem;
    border-radius: 20px;
    border-left: 3px solid var(--pf-purple);
    margin-bottom: 2.5rem;
  }

  .root-logo {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* El logo de Distamus tiene versión clara y oscura: se elige por tema.
     Sin estas reglas se pintan las dos a la vez. */
  .root-logo--dark { display: none; }
  :global([data-theme='dark']) .root-logo--dark { display: block; }
  :global([data-theme='dark']) .root-logo--light { display: none; }

  .root-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .root-text strong {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .root-text span {
    font-size: 0.95rem;
    color: var(--pg-muted);
  }

  /* ─────────── Portal ─────────── */
  .portal {
    margin-top: 1.25rem;
    padding: 1.6rem 1.85rem;
    border-radius: 20px;
    border-left: 3px solid var(--pf-blue);
  }

  .portal-tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 100px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.22);
    color: var(--pf-blue);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .portal h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .portal p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--pg-muted);
  }

  /* ─────────── Líneas abiertas ─────────── */
  .lines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .line {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.35rem 1.5rem;
    border-radius: 16px;
    background: var(--pg-surface);
    border: 1px solid var(--pg-border);
    border-top: 3px solid var(--pf-amber);
  }

  .line--done {
    border-top-color: var(--pf-teal);
  }

  .line-tag {
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--pf-amber);
  }

  .line-tag--done {
    color: var(--pf-teal);
  }

  .line strong {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .line-detail {
    font-size: 0.85rem;
    color: var(--pg-muted);
  }

  /* ─────────── Árbol ─────────── */
  .tree {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 20px;
    overflow-x: auto;
  }

  .tree pre {
    margin: 0;
  }

  .tree code {
    font-family: 'Cascadia Code', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(0.72rem, 1.6vw, 0.85rem);
    line-height: 1.85;
    color: var(--pg-muted);
    white-space: pre;
  }

  /* ─────────── Cierre ─────────── */
  .closing {
    position: relative;
    text-align: center;
    padding: clamp(4rem, 10vw, 7rem) 0;
    overflow: hidden;
  }

  .closing-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 55% at 50% 65%, rgba(139, 92, 246, 0.1), transparent);
    pointer-events: none;
  }

  .closing-inner {
    position: relative;
    max-width: 760px;
  }

  .closing-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pg-light);
    margin-bottom: 1.1rem;
  }

  .closing-quote {
    font-size: clamp(1.6rem, 4.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin-bottom: 1.35rem;
  }

  .closing-note {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--pg-muted);
  }

  /* ─────────── Pie ─────────── */
  .footer {
    border-top: 1px solid var(--pg-border);
    padding: 1.85rem 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--pg-light);
  }

  @media (max-width: 640px) {
    .hero-stats { grid-template-columns: 1fr 1fr; gap: 1.35rem; }
    .stat strong { font-size: 1.55rem; }
    .hero-acciones { flex-direction: column; align-items: stretch; }
    .hero-cta, .hero-cta-sec { justify-content: center; text-align: center; }
    .root { flex-direction: column; text-align: center; }
    .footer-inner { justify-content: center; text-align: center; }
  }
</style>
